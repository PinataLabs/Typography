<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>PinataLabs.Typography</AssemblyName>
    <AssemblyTitle>PinataLabs.Typography</AssemblyTitle>
    <RootNamespace>PinataLabs.Typography</RootNamespace>
    <PackageId>PinataLabs.Typography</PackageId>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/PinataLabs/Typography</RepositoryUrl>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <PackageTags>font;truetype;opentype;woff;woff2</PackageTags>
    <Description>A cross-platform library for loading and laying out fonts for processing and measuring; written in C#</Description>
    <TargetFrameworks>netstandard2.1;net8.0;net10.0;net11.0</TargetFrameworks>
    <AssemblyVersion Condition="'$(IsContinuousIntegration)'==''">1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <!--
    IsAotCompatible implies IsTrimmable and turns on the trim, AOT and single-file analyzers.
    The netstandard2.1 asset gets neither: the trimmer reads the attribute only on .NET assets,
    and the analyzers need the net8.0+ annotations.
  -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    The Unicode algorithms and character properties live in PinataLabs.Typography.Unicode, which has no font code.
    This assembly reads that one's internals, so the package pins it to the exact version of this one.
  -->
  <ItemGroup>
    <ProjectReference Include="..\PinataLabs.Typography.Unicode\PinataLabs.Typography.Unicode.csproj" />
  </ItemGroup>

  <!--
    README.md here is the package readme shown on nuget.org. It is a copy of the repository README
    with the build-from-source sections removed and every link made absolute: nuget.org renders no
    relative links, and serves images only from allowed hosts. The logo is in Git LFS, so it comes from
    media.githubusercontent.com; raw.githubusercontent.com returns the LFS pointer instead.
  -->
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\NOTICE" Pack="true" PackagePath="" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!--
    Public API baseline. The build fails (RS0016/RS0017) when the public surface differs from these files.
    A public API change needs an approved proposal, its own commit, a PublicAPI.Unshipped.txt change and a CHANGELOG.md entry.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="PolySharp" PrivateAssets="all" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" />
  </ItemGroup>

  <!-- Polyfills for BCL members that netstandard2.1 lacks. Every other target framework has them. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.1'">
    <Compile Remove="Polyfills\**" />
  </ItemGroup>

</Project>
