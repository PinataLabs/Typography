<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The fuzz harness of the font program API (issue #74) and of the Item Variation Store reader (issue #124).
    It is a libFuzzer target through SharpFuzz, and it has an in-process mutation runner for machines without
    libFuzzer. fuzz.ps1 publishes, instruments and runs it.
    CI builds it but does not run it: libFuzzer is a separate native binary. The test project compiles
    the oracles and Mutator.cs and replays the committed corpus, so CI checks the same contract.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpFuzz" />
  </ItemGroup>

</Project>
