# Global analyzer config for the projects under tests/ (picked up automatically by the SDK).
#
# SA0001 (XML comment analysis is disabled) is reported for the whole compilation,
# with no source file, so a file section in .editorconfig cannot configure it.
# The tests ruleset turned it off; the test projects do not generate XML docs.
# Every other rule from the old rulesets lives in the root .editorconfig.
# The SDK also applies this file to any project that compiles a file from tests/
# (the Unicode trie generator links one); that project generates XML docs, so SA0001 never fires there.
is_global = true

dotnet_diagnostic.SA0001.severity = none
