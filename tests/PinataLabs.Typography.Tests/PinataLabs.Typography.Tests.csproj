<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0;net11.0</TargetFrameworks>
    <DebugSymbols>True</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fonts\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- The oracle and the mutator of the fuzz harness, and its corpus, for the deterministic mutation tests. -->
  <ItemGroup>
    <Compile Include="..\PinataLabs.Typography.Fuzz\FontProgramOracle.cs" Link="FontPrograms\Fuzz\FontProgramOracle.cs" />
    <Compile Include="..\PinataLabs.Typography.Fuzz\ItemVariationStoreOracle.cs" Link="FontPrograms\Fuzz\ItemVariationStoreOracle.cs" />
    <Compile Include="..\PinataLabs.Typography.Fuzz\MetricsVariationOracle.cs" Link="FontPrograms\Fuzz\MetricsVariationOracle.cs" />
    <Compile Include="..\PinataLabs.Typography.Fuzz\Cff2TopDict.cs" Link="FontPrograms\Fuzz\Cff2TopDict.cs" />
    <Compile Include="..\PinataLabs.Typography.Fuzz\VariationBytes.cs" Link="FontPrograms\Fuzz\VariationBytes.cs" />
    <Compile Include="..\PinataLabs.Typography.Fuzz\TupleVariationBytes.cs" Link="FontPrograms\Fuzz\TupleVariationBytes.cs" />
    <Compile Include="..\PinataLabs.Typography.Fuzz\Mutator.cs" Link="FontPrograms\Fuzz\Mutator.cs" />
    <None Include="..\PinataLabs.Typography.Fuzz\corpus\**\*" Link="FuzzCorpus\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Pegasus" PrivateAssets="all" />
    <Compile Include="..\..\src\PinataLabs.Typography.UnicodeTrieGenerator\StateAutomation\DeterministicFiniteAutomata.cs" Link="Unicode\StateAutomation\DeterministicFiniteAutomata.cs" />
    <Compile Include="..\..\src\PinataLabs.Typography.UnicodeTrieGenerator\StateAutomation\Compile.cs" Link="Unicode\StateAutomation\Compile.cs" />
    <Compile Include="..\..\src\PinataLabs.Typography.UnicodeTrieGenerator\StateAutomation\State.cs" Link="Unicode\StateAutomation\State.cs" />
    <Compile Include="..\..\src\PinataLabs.Typography.UnicodeTrieGenerator\GeneratorPaths.cs" Link="Unicode\GeneratorPaths.cs" />
    <PegGrammar Include="..\..\src\PinataLabs.Typography.UnicodeTrieGenerator\StateAutomation\Grammar.peg" Link="Unicode\StateAutomation\Grammar.peg" />
  </ItemGroup>

</Project>
