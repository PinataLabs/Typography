<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    Settings for every project in the repository. The Directory.Build.props files under
    src/, tests/ and samples/ import this file and add the settings for their own projects.
  -->

  <!-- OS constants, used by tests that need a platform's system fonts. -->
  <PropertyGroup>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);OS_WINDOWS</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(DefineConstants);OS_OSX</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(DefineConstants);OS_LINUX</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('FreeBSD'))">$(DefineConstants);OS_FREEBSD</DefineConstants>
  </PropertyGroup>

  <!-- Compilation settings that differ from the SDK defaults. -->
  <PropertyGroup>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Features>strict</Features>
    <NeutralLanguage>en</NeutralLanguage>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>

  <!-- Build output goes to artifacts/bin, artifacts/obj and artifacts/package. -->
  <PropertyGroup>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" Visible="false" />
  </ItemGroup>

</Project>
