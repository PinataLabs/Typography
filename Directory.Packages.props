<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    Central Package Management: every package version in the repository is declared here.
    Project files and the props/targets under build/ reference packages without a version.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Analyzers applied to every project. -->
  <ItemGroup>
    <GlobalPackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
  </ItemGroup>

  <!-- Build infrastructure (build/msbuild/props). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>

  <!-- Tools and tests. -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Pegasus" Version="4.1.0" />
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="TUnit" Version="1.76.0" />
    <!--
      The standalone xUnit assertion library (no xUnit framework or runner).
      Temporary: the test assertions still use it until they move to TUnit
      assertions (#13, #14, #15). Remove it then.
    -->
    <PackageVersion Include="xunit.assert" Version="2.9.3" />
  </ItemGroup>

</Project>
