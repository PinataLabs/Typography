<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    Central Package Management: every package version in the repository is declared here.
    Project files and the props/targets under build/ reference packages without a version.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Analyzers applied to every project. -->
  <ItemGroup>
    <GlobalPackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
  </ItemGroup>

  <!-- Build infrastructure (build/msbuild/props). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
  </ItemGroup>

  <!-- Library. -->
  <ItemGroup>
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>

  <!-- Tools and tests. -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Pegasus" Version="4.1.0" />
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <!-- Samples. -->
  <ItemGroup>
    <!--
      Pinned, not latest: later versions are not Apache-2.0, and the earlier pin
      (beta15.14) is not on nuget.org. The DrawWithImageSharp sample that uses it
      no longer compiles (it needs the SixLabors strong-name key), so the solution
      does not build it; the rebrand deletes it (spec 001, scope item 15).
    -->
    <PackageVersion Include="SixLabors.ImageSharp.Drawing" Version="1.0.0-beta15" />
    <PackageVersion Include="System.ValueTuple" Version="4.6.2" />
  </ItemGroup>

</Project>
