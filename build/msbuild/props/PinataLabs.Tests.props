<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    Vendored (Apache-2.0) from SharedInfrastructure at commit 33cb12ca and modified
    by PinataLabs. NOTICE lists the upstream repository and file path.
  -->

  <!-- Compilation and build location settings. -->
  <PropertyGroup>
    <PinataLabsProjectCategory>tests</PinataLabsProjectCategory>
    <IsTestProject Condition="'$(IsTestProject)' == ''">true</IsTestProject>
    <IsPackable>false</IsPackable>
    <CodeAnalysisRuleSet Condition="'$(CodeAnalysisRuleSet)' == ''">$(MSBuildThisFileDirectory)..\..\PinataLabs.Tests.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <!--
    Package references and additional files which are consumed by test projects.
    Versions are declared centrally in Directory.Packages.props.
  -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="xunit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" PrivateAssets="All" Condition="'$(IsCodeCoverage)'=='true'"/>
  </ItemGroup>

</Project>
