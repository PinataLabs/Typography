<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    Vendored from SixLabors/SharedInfrastructure (Apache-2.0) at commit 33cb12ca,
    msbuild/props/SixLabors.Tests.props, and modified by PinataLabs.
  -->

  <!-- Compilation and build location settings. -->
  <PropertyGroup>
    <PinataLabsProjectCategory>tests</PinataLabsProjectCategory>
    <IsTestProject Condition="'$(IsTestProject)' == ''">true</IsTestProject>
    <IsPackable>false</IsPackable>
    <CodeAnalysisRuleSet Condition="'$(CodeAnalysisRuleSet)' == ''">$(MSBuildThisFileDirectory)..\..\PinataLabs.Tests.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <!--
    Package references and additional files which are consumed by test projects.
    Versions are declared centrally in Directory.Packages.props.
  -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <!--
      TUnit runs on Microsoft.Testing.Platform (selected in global.json under "test").
      It brings its own code coverage and TRX report extensions.
    -->
    <PackageReference Include="TUnit" />
  </ItemGroup>

</Project>
