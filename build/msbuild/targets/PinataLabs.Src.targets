<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    Vendored (Apache-2.0) from SharedInfrastructure at commit 33cb12ca and modified
    by PinataLabs. NOTICE lists the upstream repository and file path.

    The upstream target that copied .editorconfig, .gitattributes and codecov.yml
