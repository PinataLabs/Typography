<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    Vendored from SixLabors/SharedInfrastructure (Apache-2.0) at commit 33cb12ca,
    msbuild/targets/SixLabors.Src.targets, and modified by PinataLabs.

    The upstream target that copied .editorconfig, .gitattributes and codecov.yml
    from the submodule to the repository root is gone: those files now live in
    the repository directly.
  -->

  <!-- Empty target so that `dotnet test` will work on the solution -->
  <!-- https://github.com/Microsoft/vstest/issues/411 -->
  <Target Name="VSTest" Condition="'$(IsTestProject)' == 'true'"/>

</Project>
