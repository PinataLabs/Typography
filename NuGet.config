<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Restore from nuget.org only. Source mapping is required by Central Package Management (NU1507). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
